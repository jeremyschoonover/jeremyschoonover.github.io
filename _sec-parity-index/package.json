{
  "name": "sec-parity-index",
  "version": "1.0.0",
  "description": "The SEC Parity Index — 2026 college football Circle of Parity",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
