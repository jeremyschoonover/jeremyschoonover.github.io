{
  "name": "circle-of-suck",
  "version": "1.0.0",
  "description": "Circle of Suck: the longest loop of upsets in a league, drawn as a social post and updated after every game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsx scripts/render.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync": "tsx scripts/sync.ts",
    "publish": "npm run build && tsx scripts/publish.ts",
    "logos": "tsx scripts/logos.ts",
    "render": "tsx scripts/render.ts"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
